# Production env template — copy to `.env` on the EC2 host and fill in real values.
# DO NOT commit the filled-in `.env`.

# --- Public-facing host (EC2 public DNS) ---
# Used by backend to mint MinIO presigned URLs the browser can fetch, and by
# Grafana to build its root URL. NO trailing slash.
# With an Elastic IP attached, this value stays the same across stop/start.
# Without EIP, EC2 reassigns a new public DNS on every restart — update this
# and `docker compose up -d` again to re-render env into running containers.
PUBLIC_HOST=http://ec2-XX-XX-XX-XX.compute-1.amazonaws.com

# --- Postgres ---
POSTGRES_USER=octest
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=octest

# --- Backend auth secrets ---
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32
WORKER_SECRET=replace-me-with-openssl-rand-base64-32

# --- MinIO ---
MINIO_USER=octest-admin
MINIO_PASSWORD=changeme-strong-minio-password

# --- Grafana admin password ---
GRAFANA_PASSWORD=changeme-grafana
