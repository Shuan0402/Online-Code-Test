# Python bytecode & caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Virtual envs (must never end up in an image)
.venv/
venv/

# Editors / OS noise
.DS_Store
.vscode/
.idea/

# Local dev databases (B's test.db is a dev artifact, not source)
*.db

# Test artifacts and coverage reports — not needed at runtime
tests/
htmlcov/
coverage.xml
.coverage
*.coveragerc

# Environment / secrets — never bake into image
.env
.env.*
*.secret

# Git metadata
.git/
.gitignore
.gitattributes
