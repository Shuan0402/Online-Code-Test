        <mxCell id="postgres" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#336791;strokeColor=#1F4060;fontSize=13;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;img src=&quot;https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/div&gt;&lt;div style=&quot;font-weight:bold;color:#fff&quot;&gt;PostgreSQL&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#B0E0E6&quot;&gt;Step 2 已就位&lt;/div&gt;" vertex="1">
