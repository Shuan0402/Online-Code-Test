        <mxCell id="a-group" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;verticalAlign=top;fontStyle=1;fontSize=15;fontColor=#1B5E20;strokeWidth=2;" value="&amp;nbsp;Sandbox + Compute ✅ Step 1-7 完成" vertex="1">
