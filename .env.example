# Copy this file to `.env` and fill in real values.
# `.env` itself is git-ignored — never commit secrets.

POSTGRES_USER=octest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=octest

# Backend auth secret — placeholder slot, used when SHUAN implements JWT auth.
# Generate a real one with: openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32

# Worker → backend callback authentication.
# Shared secret carried in X-Worker-Secret header on /internal/judge-callback.
# Generate a real one with: openssl rand -base64 32
WORKER_SECRET=replace-me-with-openssl-rand-base64-32

# Worker 併發上限（OJ Story 1 AC2）。compose 的 worker.deploy.replicas 讀這個值，
# 多開 N 個 judge-worker container 並排吃 redis queue（每個仍是 serial loop）。
# 預設 1；拉高範例：WORKER_CONCURRENCY=4 docker compose up -d worker
WORKER_CONCURRENCY=1

# MinIO root credentials — backend uses these to upload submissions and sign
# pre-signed GET URLs that workers fetch. Console UI at http://localhost:9001.
MINIO_USER=octest-admin
MINIO_PASSWORD=changeme-minio

# Fureture Work
# Frontend url
# FRONTEND_HOST=https: ...

# Need to eplace
GRAFANA_PASSWORD=admin

SONARQUBE_TOKEN=replace-me-with-sonarqube-token